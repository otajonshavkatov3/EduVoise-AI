# ===========================================
# My App - Environment Variables
# ===========================================

# Environment
NODE_ENV=development

# ===========================================
# Backend
# ===========================================

# Server
PORT=4000
HOST=0.0.0.0

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# Database (PostgreSQL)
# ===========================================

# Connection URL (used by app)
DATABASE_URL=postgresql://myapp:your_secure_password@localhost:5432/myapp

# Docker Compose variables
POSTGRES_USER=myapp
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=myapp
POSTGRES_PORT=5432

# ===========================================
# Redis
# ===========================================

# Connection URL (used by app)
REDIS_URL=redis://:your_redis_password@localhost:6379

# Docker Compose variables
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# ===========================================
# Frontend
# ===========================================

VITE_API_URL=http://localhost:4000

# Browser softphone (SIP.js over WebSocket). autoConnect defaults to false so
# the dashboard never retries a dead socket forever. Browser calling also needs
# a wss transport and DTLS certs on Asterisk - see docs/ASTERISK.md.
VITE_SIP_WS_URL=ws://localhost:8088/ws
VITE_SIP_EXTENSION=
VITE_SIP_PASSWORD=
VITE_SIP_REALM=127.0.0.1

# ===========================================
# AI VOICE PLATFORM (Asterisk + OpenAI Realtime)
# ===========================================
# Replaces the FreePBX telephony layer. The legacy /api/webhooks/freepbx
# endpoints remain available for backward compatibility.

# --- Asterisk ARI (call control: REST + WebSocket events) ---
ASTERISK_ARI_URL=http://localhost:8088/ari
ASTERISK_ARI_WS_URL=ws://localhost:8088/ari/events
ASTERISK_ARI_APP=callcenter-ai
ASTERISK_ARI_USERNAME=callcenter-ari
# SECRET - generate with: openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32
ASTERISK_ARI_PASSWORD=generate_a_32_char_secret

# --- Asterisk AMI (endpoint / registration state) ---
ASTERISK_AMI_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=callcenter-ami
# SECRET
ASTERISK_AMI_PASSWORD=generate_a_32_char_secret

# --- AudioSocket: Asterisk dials IN to the backend over TCP ---
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9092
# What the dialplan is told to connect back to. Inside Docker the backend runs
# on the host, so this is host.docker.internal - NOT localhost.
AUDIOSOCKET_ADVERTISE_HOST=host.docker.internal:9092

# --- SIP extensions (SECRETS - one per operator endpoint) ---
SIP_EXT_101_PASSWORD=generate_a_24_char_secret
SIP_EXT_102_PASSWORD=generate_a_24_char_secret
SIP_EXT_103_PASSWORD=generate_a_24_char_secret
SIP_EXT_104_PASSWORD=generate_a_24_char_secret

# --- Voicemail PINs (SECRETS) ---
VOICEMAIL_PIN_101=100000
VOICEMAIL_PIN_102=100000
VOICEMAIL_PIN_103=100000
VOICEMAIL_PIN_104=100000

# --- SIP / RTP ports ---
# 5070 rather than 5060 on the dev host because MicroSIP already owns 5060.
# On a dedicated server you can use 5060.
ASTERISK_SIP_PORT=5070
# Keep this range SMALL on Docker Desktop: it creates one userland proxy per
# published UDP port. 50 ports = 25 concurrent calls. Widen it on real Linux.
ASTERISK_RTP_START=12000
ASTERISK_RTP_END=12049

# --- OpenAI ---
# SECRET. Needs project access to a realtime model; verify with
# tests/e2e/run-verification.ts. See docs/AI_PROVIDER.md if you get
# model_not_found.
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# --- AI agent behaviour ---
AI_AGENT_ENABLED=true
AI_AGENT_EXTENSION=900
AI_AGENT_LANGUAGE=uz
AI_AGENT_GREETING_DELAY_MS=300
AI_AGENT_MAX_CALL_SECONDS=900
AI_AGENT_SILENCE_HANGUP_MS=20000
AI_TRANSFER_EXTENSIONS=101,102,103,104

# --- Recording ---
# First is the path inside the Asterisk container, second is where the backend
# reads the same bind-mounted files from.
ASTERISK_RECORDINGS_DIR=/var/spool/asterisk/recordings
RECORDINGS_DIR=./apps/backend/uploads/call-recordings

# Tashqi (NAT) manzil РІР‚вЂќ telefon boshqa qurilmada bo'lganda MAJBURIY.
#
# Bo'sh qoldirilsa: Asterisk faqat shu kompyuter ichidan ishlaydi (MicroSIP,
# brauzer). Docker'ning ichki IP'sini (172.x) e'lon qiladi va uni Wi-Fi'dagi
# telefon topa olmaydi РІР‚вЂќ natijada siz AI'ni eshitasiz, AI sizni eshitmaydi.
#
# To'ldirilsa: Asterisk shu manzilni e'lon qiladi va tashqi telefon o'z ovozini
# to'g'ri joyga yuboradi. Qiymatlar:
#   Wi-Fi'dagi telefon uchun  -> shu kompyuterning LAN IP'si (masalan 192.168.1.109)
#   Mobil internet / trunk    -> serverning ochiq (public) IP'si yoki domeni
# LAN IP DHCP bilan o'zgarishi mumkin: o'zgarsa shu qatorni yangilash kerak.
ASTERISK_EXTERNAL_ADDRESS=

#=============================================================================
# PSTN TRUNK РІР‚вЂќ haqiqiy telefon raqamini ulash (ixtiyoriy)
#
# SIP_TRUNK_HOST bo'sh bo'lsa trunk umuman yaratilmaydi va Asterisk avvalgidek
# ishlaydi. Provayderdan ma'lumot olganingizda shu qatorlarni to'ldiring.
#
# Kelayotgan qo'ng'iroqlar [from-external] kontekstiga tushadi va u ISTALGAN
# raqamni to'g'ridan-to'g'ri AI'ga uzatadi РІР‚вЂќ dialplan'ga qo'shimcha kod kerak emas.
#=============================================================================

# Provayderning SIP serveri. Port kerak bo'lsa: sip.provayder.uz:5060
SIP_TRUNK_HOST=

# "register" РІР‚вЂќ biz provayderga login/parol bilan ulanamiz (eng keng tarqalgani)
# "ip"       РІР‚вЂќ provayder bizning server IP'mizni oq ro'yxatga oladi, parol yo'q
SIP_TRUNK_AUTH_MODE=register

# AUTH_MODE=register uchun majburiy
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=

# Provayder bergan raqam, to'liq formatda (masalan 998712001122).
# Chiquvchi qo'ng'iroqlarda Caller ID sifatida ishlatiladi.
SIP_TRUNK_DID=

# Provayderning signal IP manzillari, vergul bilan.
# AUTH_MODE=ip uchun MAJBURIY; "register" uchun ham tavsiya etiladi РІР‚вЂќ
# shu ro'yxat internetdagi tasodifiy skanerni operator deb qabul qilishni to'sadi.
SIP_TRUNK_IPS=

# Odatda o'zgartirish kerak emas
SIP_TRUNK_TRANSPORT=transport-udp
SIP_TRUNK_CODECS=ulaw,alaw
SIP_TRUNK_DTMF_MODE=rfc4733
SIP_TRUNK_SRTP=no
SIP_TRUNK_REGISTER_EXPIRY=3600
# Provayder boshqa domen talab qilsa
SIP_TRUNK_FROM_DOMAIN=

# --- Ovoz va suhbat sifati (ixtiyoriy, bo'sh qoldirilsa standart ishlatiladi) ---
# Ovoz: alloy, ash, ballad, cedar, coral, echo, marin, sage, shimmer, verse.
# Standart cedar вЂ” telefon liniyasida eng tabiiy eshitiladigan ikkitasidan biri.
# Biznes profilidagi "voice" maydoni bundan ustun turadi.
OPENAI_REALTIME_VOICE=cedar

# Gapirish tezligi (0.25-1.5). 0.95 вЂ” tor polosali liniyada undoshlar yo'qolmasligi uchun.
OPENAI_REALTIME_SPEED=0.95

# Navbat almashish: semantic_vad (standart) gap tugaganini model aniqlaydi,
# server_vad esa jimlikni sanaydi. semantic_vad mijozni o'ylab turganda bo'lmaydi.
OPENAI_REALTIME_TURN_MODE=semantic_vad
# Qanchalik tez "gap tugadi" deb qaror qiladi: low | medium | high | auto.
# low = eng sabrli. Manzil va raqamlarni bo'lib aytadigan mijozlar uchun shu to'g'ri.
OPENAI_REALTIME_VAD_EAGERNESS=auto

# Bitta javobning chegarasi. Prompt qisqalikni talab qiladi; bu вЂ” talab
# bajarilmagan holat uchun tosiq. ~30 soniyalik nutq.
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=1200

# --- ElevenLabs (ixtiyoriy ovoz provayderi) ---
ELEVENLABS_API_KEY=
# Model: eleven_v3 (eng yaxshi o'zbekcha, ~1.7 s kechikish — faqat oldindan
# yozib qo'yiladigan doimiy jumlalar uchun) yoki eleven_flash_v2_5 (~0.2 s).
ELEVENLABS_MODEL=eleven_v3
# Ovoz. Ro'yxatni ko'rish: GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Doimiy jumlalarni (salomlashuv, xayrlashuv) ElevenLabs ovozida aytish.
# STANDART: false. Yoqilsa qo'ng'iroq ikki xil ovozda ketadi — salomlashuv
# ElevenLabs, qolgani suhbat modeli ovozida — bu mijozga uzatilgandek eshitiladi.
# Faqat butun suhbat SHU ovozda ketadigan bo'lsa yoqing.
ELEVENLABS_FIXED_LINES=false

# --- Google Gemini Live (nutqdan-nutqqa ovoz provayderi) ---
# O'zbekcha uchun tanlangan. Almashtirish: AI_VOICE_PROVIDER=gemini yoki openai.
# Qatorni olib tashlasangiz OpenAI Realtime'ga qaytadi.
AI_VOICE_PROVIDER=gemini
GOOGLE_AI_API_KEY=
# 831 ms birinchi audio. gemini-2.5-flash-native-audio-latest 5173 ms - ishlatmang.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Sinalgan ovozlar: Aoede, Kore, Leda, Autonoe, Callirrhoe, Zephyr, Despina, Erinome
GEMINI_LIVE_VOICE=Callirrhoe
