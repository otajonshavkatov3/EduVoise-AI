{
  "name": "backend",
  "scripts": {
    "dev": "bun --env-file=../../.env run --hot src/index.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "db:seed": "bun --env-file=../../.env run src/db/seed.ts",
    "db:seed:sip": "bun --env-file=../../.env run src/db/seedSipExtensions.ts",
    "db:seed:ai": "bun --env-file=../../.env run src/db/seedAiAgent.ts",
    "db:seed:vendor": "bun --env-file=../../.env run src/db/seedVendor.ts",
    "db:seed:ministry": "bun --env-file=../../.env run src/db/seedMinistry.ts",
    "db:reset": "bun --env-file=../../.env run src/db/reset.ts",
    "db:demo": "bun run db:reset && bun run db:seed && bun run db:seed:sip && bun run db:seed:ai && bun run db:seed:vendor"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@hono/zod-openapi": "^1.2.0",
    "@scalar/hono-api-reference": "^0.9.33",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "hono": "^4.11.4",
    "hono-pino": "^0.10.3",
    "jose": "^6.1.3",
    "pg": "^8.16.3",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "stoker": "^2.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8"
  }
}
